; SYNC consumer only - producer bit (0x40000000) deliberately NOT set,
; unlike the master's 0x1005. CO_SYNC_init() requires 1006/1007/1019 too
; whenever 1005 exists at all (same pattern as canopen-master.dcf) - but
; this node only consumes, so 1006/1007/1019 just need to exist, their
; values are irrelevant to consumption.
[1005]
ParameterName=COB-ID SYNC message
ObjectType=0x7
;StorageLocation=PERSIST_COMM
DataType=0x0007
AccessType=rw
DefaultValue=0x00000080
PDOMapping=0

[1006]
ParameterName=Communication cycle period
ObjectType=0x7
;StorageLocation=PERSIST_COMM
DataType=0x0007
AccessType=rw
DefaultValue=0
PDOMapping=0

[1007]
ParameterName=Synchronous window length
ObjectType=0x7
;StorageLocation=RAM
DataType=0x0007
AccessType=rw
DefaultValue=0
PDOMapping=0

[1019]
ParameterName=Synchronous counter overflow value
ObjectType=0x7
;StorageLocation=RAM
DataType=0x0005
AccessType=rw
DefaultValue=0
PDOMapping=0

; TPDO1, pre-configured enabled (COB-ID bit31 clear) with transmission
; type 1 - "send on every SYNC" - so it fires visibly in lockstep with
; the master's SYNC tick, no extra SDO configuration needed before
; testing. Maps 0x2003 (INTEGER32 test value) - SDO-writable, so you can
; write a distinctive value and watch it appear here on the next SYNC.
[1800]
ParameterName=TPDO communication parameter
ObjectType=0x9
;StorageLocation=PERSIST_COMM
SubNumber=0x6

