; ---- One object per common CANopen datatype, 0x2000-0x200B ----
; Each ParameterName ends with the datatype in parentheses deliberately -
; that's the string the future name-based lookup table (priority item 3)
; will need to key off. Skipped the odd bit-width types (INTEGER24/40/48/56,
; UNSIGNED24/40/48/56) on purpose - rarely implemented in practice (not
; natively supported by CANopenNode's own OD interface types either) and
; would just add noise to a "one entry per commonly-used datatype" set.
; 0x2008/0x2009 (VISIBLE_STRING/OCTET_STRING) are also the >4-byte objects
; needed to finally test segmented SDO against a real CANopenNode server
; (CO_SDOserver.c), not just CANopenUno's hand-written one - see the open
; item on today's status.

[2000]
ParameterName=Test value (BOOLEAN)
ObjectType=0x7
;StorageLocation=RAM
DataType=0x0001
AccessType=rw
DefaultValue=0x00
PDOMapping=0

[2001]
ParameterName=Test value (INTEGER8)
ObjectType=0x7
;StorageLocation=RAM
DataType=0x0002
AccessType=rw
DefaultValue=-12
PDOMapping=0

[2002]
ParameterName=Test value (INTEGER16)
ObjectType=0x7
;StorageLocation=RAM
DataType=0x0003
AccessType=rw
DefaultValue=-1234
PDOMapping=0

